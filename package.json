{
  "name": "workdaytracker",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "mobile": "node scripts/mobile-server.mjs",
    "generate:production-qr": "node scripts/generate-production-qr.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test \"src/*.test.js\" \"scripts/*.test.mjs\"",
    "test:ui": "node scripts/validate-history-ui.mjs",
    "test:ux": "node scripts/validate-mobile-ux.mjs",
    "test:route": "node scripts/validate-route-ui.mjs",
    "test:recovery": "node scripts/validate-recovery-ui.mjs",
    "test:design": "node scripts/validate-design-ui.mjs",
    "test:durations": "node scripts/validate-durations-ui.mjs",
    "test:statistics": "node scripts/validate-statistics-ui.mjs",
    "test:upgrade": "node scripts/validate-upgrade.mjs",
    "test:webkit": "playwright test",
    "test:release": "npm test && npm run lint && npm run build && npm run test:ui -- --production && npm run test:ux -- --production && npm run test:route && npm run test:upgrade && npm run test:webkit && npm run test:ux -- --production --webkit && npm run test:route -- --webkit && npm run test:recovery && npm run test:recovery -- --webkit && npm run test:design && npm run test:design -- --webkit && npm run test:durations && npm run test:durations -- --webkit && npm run test:statistics && npm run test:statistics -- --webkit",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "qrcode-terminal": "^0.12.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
